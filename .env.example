NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Your deployed domain — used for metadataBase, Open Graph image URLs,
# robots.txt, and sitemap.xml. Falls back to the project's own Vercel URL
# if unset.
NEXT_PUBLIC_SITE_URL=

# Optional — production hardening. The app runs fine without any of these;
# each feature just no-ops until its key is set. See README for details.

# Rate limiting (Upstash Redis free tier: https://upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error monitoring (https://sentry.io)
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Phase 2: automatic Keigo/nuance classification on new entries (Groq, free tier: https://console.groq.com)
GROQ_API_KEY=

# Phase 2: semantic search embeddings (OpenAI text-embedding-3-small)
OPENAI_API_KEY=
